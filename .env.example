# ============================================================
# YTLens Environment Configuration Template
# ============================================================

# --- OpenAI Configuration ---
# Required for text-embedding-3-small (embeddings) and optional for chat
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chat Model Provider Toggle ---
# Set to "openai" (uses OPENAI_CHAT_MODEL) or "huggingface" (free test endpoint)
CHAT_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-5-nano

# --- HuggingFace (Required if CHAT_PROVIDER=huggingface) ---
HUGGINGFACEHUB_API_TOKEN=
HUGGINGFACE_CHAT_MODEL=openai/gpt-oss-20b

# --- Authentication & Session Security ---
JWT_SECRET=your_long_random_jwt_secret_here
DEFAULT_USER=admin
DEFAULT_PASS=secret

# --- Pinecone Vector Database ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ytlens

# --- Webshare Residential Proxy (Optional) ---
# Used for YouTube transcript fetch IP-bypass on cloud servers.
# Leave blank to skip proxy layer with zero added latency.
WEBSHARE_USER=
WEBSHARE_PASS=

# --- Neural Reranker (Optional) ---
# Set to "true" only on machines with >= 1GB RAM. Default is "false"
# for memory-constrained hosts (e.g. Render 512MB free tier).
ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-2-v2
